{
  "name": "xhunt",
  "displayName": "XHunt – Community Firefox Port",
  "version": "0.4.1",
  "description": "Unofficial Firefox port of the public XHunt extension (local features only)",
  "homepage_url": "https://github.com/JinSooo/tweet-hunt-extension",
  "author": "luykin",
  "scripts": {
    "dev": "plasmo dev --env=.env.pro",
    "dev-test": "plasmo dev --env=.env.dev",
    "clean:build": "rm -rf build",
    "build:analyze": "npm run clean:build && NODE_ENV=production ANALYZE=true plasmo build --env=.env.pro",
    "build:dev": "npm run clean:build && NODE_ENV=development plasmo build --env=.env.dev",
    "package:store": "timestamp=$(date +%Y%m%d-%H%M) && rm -f build/xhunt-store-upload.zip && cd build/chrome-mv3-prod && zip -r -X ../xhunt-store-upload-${timestamp}.zip . -x '*.DS_Store' -x '__MACOSX/*' && cd ../.. && cp build/xhunt-store-upload-${timestamp}.zip build/xhunt-store-upload.zip && echo \"Store package: build/xhunt-store-upload-${timestamp}.zip\"",
    "test:e2e": "playwright test tests/e2e",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "lint:firefox": "web-ext lint --source-dir build/firefox-mv3-prod",
    "package:firefox": "python3 scripts/package-firefox.py && web-ext lint --source-dir build/firefox-official",
    "package:firefox:source": "npm run build:firefox && npm run lint:firefox && web-ext build --source-dir build/firefox-mv3-prod --artifacts-dir build/firefox-artifacts --overwrite-dest",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs && python3 -m unittest discover -s tests/unit -p 'test_*.py'"
  },
  "manifest": {
    "permissions": [
      "idle",
      "storage"
    ],
    "host_permissions": [
      "https://x.com/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "@xhunt-firefox.jinsooo",
        "strict_min_version": "142.0",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.6.0",
    "@plasmohq/storage": "^1.9.0",
    "@types/d3-cloud": "^1.2.9",
    "@types/qrcode": "^1.5.6",
    "ahooks": "^3.7.8",
    "axios": "^1.10.0",
    "d3": "^7.8.5",
    "d3-cloud": "^1.2.5",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "dayjs": "^1.11.13",
    "lucide-react": "^0.476.0",
    "numeral": "^2.0.6",
    "plasmo": "^0.84.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "recharts": "^2.8.0",
    "tailwindcss": "^3.3.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.23.0",
    "@playwright/test": "^1.61.1",
    "@types/chrome": "^0.0.246",
    "@types/d3": "^7.4.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/node": "^20.5.9",
    "@types/numeral": "^2.0.5",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "autoprefixer": "^10.4.15",
    "axios": "^1.10.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-plugin-transform-remove-debugger": "^6.9.4",
    "caniuse-lite": "^1.0.30001787",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.33.0",
    "daisyui": "^5.5.14",
    "detect-libc": "^2.0.4",
    "postcss": "^8.4.29",
    "terser": "^5.42.0",
    "typescript": "^5.2.2",
    "web-ext": "10.8.0",
    "xlsx": "^0.18.5"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "homepage": "https://github.com/JinSooo/tweet-hunt-extension"
}
